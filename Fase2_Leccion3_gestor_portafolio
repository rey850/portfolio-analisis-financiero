al_accion * (1 + rendimiento_mensual * 1.5 / 100) ** meses\n","    val_mod = capital_accion * (1 + rendimiento_mensual       / 100) ** meses\n","    val_pes = capital_accion * (1 + rendimiento_mensual * 0.5 / 100) ** meses\n","\n","    print(f\"  {ticker} — {int(porcentaje*100)}% del portafolio (${capital_accion:,.0f})\")\n","    print(f\"  Rendimiento histórico: {rendimiento_historico:.2f}%\")\n","    print(f\"  🟢 Optimista:  ${val_opt:,.2f}\")\n","    print(f\"  🟡 Moderado:   ${val_mod:,.2f}\")\n","    print(f\"  🔴 Pesimista:  ${val_pes:,.2f}\")\n","    print()\n","\n","    resultados.append({\n","        \"ticker\": ticker,\n","        \"capital\": capital_accion,\n","        \"opt\": val_opt,\n","        \"mod\": val_mod,\n","        \"pes\": val_pes\n","    })\n","\n","# Totales del portafolio\n","total_opt = sum(r[\"opt\"] for r in resultados)\n","total_mod = sum(r[\"mod\"] for r in resultados)\n","total_pes = sum(r[\"pes\"] for r in resultados)\n","\n","print(f\"{'='*55}\")\n","print(f\"  RESUMEN TOTAL DEL PORTAFOLIO\")\n","print(f\"{'='*55}\")\n","print(f\"  Capital inicial:   ${capital_total:,.2f}\")\n","print(f\"  🟢 Optimista:      ${total_opt:,.2f}  (+${total_opt-capital_total:,.2f})\")\n","print(f\"  🟡 Moderado:       ${total_mod:,.2f}  (+${total_mod-capital_total:,.2f})\")\n","print(f\"  🔴 Pesimista:      ${total_pes:,.2f}  (+${total_pes-capital_total:,.2f})\")\n","\n","# Impuestos\n","print(f\"\\n{'='*55}\")\n","print(f\"  DESPUÉS DE IMPUESTOS (ISR 10%)\")\n","print(f\"{'='*55}\")\n","for nombre, total in [(\"🟢 Optimista\", total_opt), (\"🟡 Moderado\", total_mod), (\"🔴 Pesimista\", total_pes)]:\n","    ganancia = total - capital_total\n","    if ganancia > 0:\n","        impuesto = ganancia * 0.10\n","        neto = capital_total + ganancia - impuesto\n","        print(f\"  {nombre}: ${neto:,.2f}  (impuesto: ${impuesto:,.2f})\")\n","    else:\n","        print(f\"  {nombre}: ${total:,.2f}  (pérdida — sin impuesto)\")\n","\n","# Gráfica de pastel — distribución\n","labels = [f\"{r['ticker']}\\n{int(p*100)}%\" for r, (_, p) in zip(resultados, portafolio)]\n","sizes = [r[\"capital\"] for r in resultados]\n","colores = [\"#FF6B6B\", \"#4ECDC4\", \"#45B7D1\"]\n","\n","plt.figure(figsize=(12, 5))\n","\n","plt.subplot(1, 2, 1)\n","plt.pie(sizes, labels=labels, colors=colores, autopct=\"%1.0f%%\", startangle=90)\n","plt.title(\"Distribución del portafolio\")\n","\n","plt.subplot(1, 2, 2)\n","tickers_lista = [r[\"ticker\"] for r in resultados]\n","opts = [r[\"opt\"] for r in resultados]\n","mods = [r[\"mod\"] for r in resultados]\n","pess = [r[\"pes\"] for r in resultados]\n","\n","x = range(len(tickers_lista))\n","width = 0.25\n","plt.bar([i - width for i in x], opts, width, color=\"green\",  alpha=0.7, label=\"🟢 Optimista\")\n","plt.bar([i         for i in x], mods, width, color=\"orange\", alpha=0.7, label=\"🟡 Moderado\")\n","plt.bar([i + width for i in x], pess, width, color=\"red\",    alpha=0.7, label=\"🔴 Pesimista\")\n","plt.xticks(x, tickers_lista)\n","plt.title(\"Proyección por acción\")\n","plt.ylabel(\"Valor estimado ($)\")\n","plt.legend()\n","plt.grid(True, alpha=0.3)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(f\"\\n⚠️  Proyección estimada basada en historial\")\n","print(f\"    Consulta a un contador para aspectos fiscales\")"]}]}
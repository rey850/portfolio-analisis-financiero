 ambas\n","\n","2. Ruptura de soporte\n","\n","   Precio cae por debajo de MA50  y no rebota\n","\n","3. Tendencia débil\n","\n","   Precio < MA20 < MA50 las tres en orden descendente\n","\n","   ⚠️ SEÑALES MIXTAS — esperar\n","\n","   Precio entre MA20 y MA50, Las líneas se cruzan repetidamente Sin dirección clara"],"metadata":{"id":"N7a7wYzE26Kr"}},{"cell_type":"code","source":["# Lección 12: Detector de señales de compra y venta\n","\n","import yfinance as yf\n","import matplotlib.pyplot as plt\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","datos = yf.download(\"AAPL\", period=\"1y\", progress=False)\n","\n","datos[\"MA20\"] = datos[\"Close\"].rolling(20).mean()\n","datos[\"MA50\"] = datos[\"Close\"].rolling(50).mean()\n","\n","# Detectar señales\n","datos[\"Señal\"] = 0\n","datos.loc[datos[\"MA20\"] > datos[\"MA50\"], \"Señal\"] = 1  # compra\n","datos.loc[datos[\"MA20\"] < datos[\"MA50\"], \"Señal\"] = -1  # venta\n","\n","# Detectar cruces\n","datos[\"Cruce\"] = datos[\"Señal\"].diff()\n","\n","compras = datos[datos[\"Cruce\"] == 2]\n","ventas = datos[datos[\"Cruce\"] == -2]\n","\n","# Gráfica\n","plt.figure(figsize=(12, 5))\n","plt.plot(datos[\"Close\"], color=\"gray\", linewidth=1, alpha=0.6, label=\"Precio\")\n","plt.plot(datos[\"MA20\"], color=\"blue\", linewidth=2, label=\"MA20\")\n","plt.plot(datos[\"MA50\"], color=\"red\", linewidth=2, label=\"MA50\")\n","\n","# Marcar señales\n","plt.scatter(compras.index, compras[\"Close\"], marker=\"^\", color=\"green\", s=200, zorder=5, label=\"COMPRA\")\n","plt.scatter(ventas.index, ventas[\"Close\"], marker=\"v\", color=\"red\", s=200, zorder=5, label=\"VENTA\")\n","\n","plt.title(\"AAPL — Señales de Compra y Venta\")\n","plt.legend()\n","plt.grid(True)\n","plt.show()\n","\n","print(f\"\\nSeñales de COMPRA: {len(compras)}\")\n","print(f\"Señales de VENTA: {len(ventas)}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":522},"id":"nnzgBR2m5Bza","executionInfo":{"status":"o
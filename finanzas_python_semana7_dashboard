{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyO/v63E6aABx2LnJt5TjhFG"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# Lección 13: Dashboard financiero completo\n","\n","import yfinance as yf\n","import matplotlib.pyplot as plt\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","ticker = \"AAPL\"\n","datos = yf.download(ticker, period=\"1y\", progress=False)\n","\n","datos[\"MA20\"] = datos[\"Close\"].rolling(20).mean()\n","datos[\"MA50\"] = datos[\"Close\"].rolling(50).mean()\n","datos[\"Rendimiento\"] = datos[\"Close\"].pct_change() * 100\n","\n","fig, axes = plt.subplots(3, 1, figsize=(14, 12))\n","fig.suptitle(f\"Dashboard — {ticker}\", fontsize=16, fontweight=\"bold\")\n","\n","# Panel 1: Precio + Promedios móviles\n","axes[0].plot(datos[\"Close\"], color=\"green\", linewidth=1, alpha=0.6, label=\"Precio\")\n","axes[0].plot(datos[\"MA20\"], color=\"blue\", linewidth=2, label=\"MA20\")\n","axes[0].plot(datos[\"MA50\"], color=\"red\", linewidth=2, label=\"MA50\")\n","axes[0].set_title(\"Precio y Promedios Móviles\")\n","axes[0].legend()\n","axes[0].grid(True)\n","\n","# Panel 2: Rendimiento diario\n","colores = [\"green\" if x >= 0 else \"red\" for x in datos[\"Rendimiento\"].fillna(0)]\n","axes[1].bar(datos.index, datos[\"Rendimiento\"].fillna(0), color=colores, alpha=0.7)\n","axes[1].axhline(y=0, color=\"black\", linewidth=1)\n","axes[1].set_title(\"Rendimiento diario %\")\n","axes[1].grid(True)\n","\n","# Panel 3: Rendimiento acumulado\n","rendimiento_acumulado = (1 + datos[\"Rendimiento\"].fillna(0) / 100).cumprod() * 100\n","axes[2].plot(rendimiento_acumulado, color=\"red\", linewidth=2)\n","axes[2].axhline(y=100, color=\"gray\", linestyle=\"--\")\n","axes[2].set_title(\"Rendimiento acumulado (base 100)\")\n","axes[2].grid(True)\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"id":"1VQyw1467Hdc","exe
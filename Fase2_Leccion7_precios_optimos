==============================================\n","\n","import yfinance as yf\n","import matplotlib.pyplot as plt\n","import numpy as np\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","# ================================\n","# MODIFICA SOLO ESTA SECCIÓN ↓\n","ticker = \"GMEXICOB.MX\"\n","periodo = \"6mo\"\n","# ================================\n","\n","datos = yf.download(ticker, period=periodo, progress=False)\n","precio_actual = float(datos[\"Close\"].iloc[-1])\n","ma20 = float(datos[\"Close\"].rolling(20).mean().iloc[-1])\n","ma50 = float(datos[\"Close\"].rolling(50).mean().iloc[-1])\n","\n","# Método 1 — Soporte y Resistencia\n","soporte     = float(datos[\"Close\"].rolling(20).min().iloc[-1])\n","resistencia = float(datos[\"Close\"].rolling(20).max().iloc[-1])\n","\n","# Método 2 — Basado en Promedios Móviles\n","compra_ma  = ma50              # Compra cerca de MA50\n","venta_ma   = precio_actual * 1.20  # Vende cuando sube 20%\n","\n","# Método 3 — Regla 20/10\n","compra_regla = precio_actual * 0.90   # Si baja 10% desde hoy\n","venta_regla  = precio_actual * 1.20   # Si sube 20% desde hoy\n","\n","# Precio óptimo — promedio de los 3 métodos\n","precio_compra_optimo = (soporte + compra_ma + compra_regla) / 3\n","precio_venta_optimo  = (resistencia + venta_ma + venta_regla) / 3\n","\n","# Reporte\n","print(f\"{'='*55}\")\n","print(f\"  PRECIOS ÓPTIMOS — {ticker}\")\n","print(f\"{'='*55}\")\n","print(f\"  Precio actual:        ${precio_actual:.2f}\")\n","print(f\"  MA20:                 ${ma20:.2f}\")\n","print(f\"  MA50:                 ${ma50:.2f}\")\n","print(f\"\\n  --- ANÁLISIS DE COMPRA ---\")\n","print(f\"  Soporte (mínimo 20d): ${soporte:.2f}\")\n","print(f\"  Cerca de MA50:        ${compra_ma:.2f}\")\n","print(f\"  Regla -10%:           ${compra_regla:.2f}\")\n","print(f\"\\n  ✅ PRECIO ÓPTIMO DE COMPRA: ${precio_compra_optimo:.2f}\")\n","print(f\"  ({((precio_compra_optimo - precio_actual) / precio_actual * 100):+.2f}% desde hoy)\")\n","\n","print(f\"\\n  --- ANÁLISIS DE VENTA ---\")\n","print(f\"  Resistencia (máx 20d): ${resistencia:.2f}\")\n","print(f\"  Objetivo +20%:         ${venta_ma:.2f}\")\n","print(f\"  Regla +20%:            ${venta_regla:.2f}\")\n","print(f\"\\n  🎯 PRECIO ÓPTIMO DE VENTA: ${precio_venta_optimo:.2f}\")\n","print(f\"  ({((precio_venta_optimo - precio_actual) / precio_actual * 100):+.2f}% desde hoy)\")\n","\n","# Gráfica\n","plt.figure(figsize=(12, 6))\n","plt.plot(datos[\"Close\"], color=\"gray\", linewidth=1, alpha=0.6, label=\"Precio\")\n","plt.plot(datos[\"Close\"].rolling(20).mean(), color=\"blue\", linewidth=2, label=\"MA20\")\n","plt.plot(datos[\"Close\"].rolling(50).mean(), color=\"red\", linewidth=2, label=\"MA50\")\n","plt.axhline(y=precio_compra_optimo, color=\"green\", linewidth=2,\n","            linestyle=\"--\", label=f\"✅ Compra óptima ${precio_compra_optimo:.2f}\")\n","plt.axhline(y=precio_venta_optimo, color=\"orange\", linewidth=2,\n","            linestyle=\"--\", label=f\"🎯 Venta óptima ${precio_venta_optimo:.2f}\")\n","plt.axhline(y=precio_actual, color=\"white\", linewidth=1,\n","            linestyle=\":\", label=f\"Precio actual ${precio_actual:.2f}\")\n","plt.title(f\"{ticker} — Precios Óptimos de Compra y Venta\")\n","plt.xlabel(\"Fecha\")\n","plt.ylabel(\"Precio ($)\")\n","plt.legend()\n","plt.grid(True, alpha=0.3)\n","plt.tight_layout()\n","plt.show()\n","\n","print(f\"\\n{'='*55}\")\n","print(f\"  RESUMEN FINAL\")\n","print(f\"{'='*55}\")\n","print(f\"  Si el precio baja a ${precio_compra_optimo:.2f} → COMPRA ✅\")\n","print(f\"  Si el precio sube a ${precio_venta_optimo:.2f} → VENDE 🎯\")\n","print(f\"  Ganancia potencial: {((precio_venta_optimo - precio_compra_optimo) / precio_compra_optimo * 100):.2f}%\")\n","print(f\"{'='*55}\")\n","print(f\"⚠️  Basado en análisis técnico — no es garantía\")"]}]}
{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMoXHWLnyHBtuKl0eUdEwAf"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# Lección 14 versión final: Ranking + Gráficas automáticas\n","\n","import yfinance as yf\n","import matplotlib.pyplot as plt\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","tickers = [\"INOD\", \"SLNH\", \"RXT\", \"FROG\", \"AAPL\"]\n","resultados = []\n","\n","for ticker in tickers:\n","    datos = yf.download(ticker, period=\"6mo\", progress=False)\n","\n","    precio_actual = float(datos[\"Close\"].iloc[-1])\n","    precio_inicio = float(datos[\"Close\"].iloc[0])\n","    rendimiento = ((precio_actual - precio_inicio) / precio_inicio) * 100\n","    volatilidad = float(datos[\"Close\"].pct_change().std() * 100)\n","    ma20 = float(datos[\"Close\"].rolling(20).mean().iloc[-1])\n","    ma50 = float(datos[\"Close\"].rolling(50).mean().iloc[-1])\n","    señal = \"✅ COMPRA\" if ma20 > ma50 else \"🔴 VENTA\"\n","    ganancia = (rendimiento / 100) * 10000\n","\n","    resultados.append({\n","        \"ticker\": ticker,\n","        \"rendimiento\": rendimiento,\n","        \"ganancia\": ganancia,\n","        \"volatilidad\": volatilidad,\n","        \"señal\": señal,\n","        \"datos\": datos\n","    })\n","\n","# Ordenar por rendimiento\n","resultados.sort(key=lambda x: x[\"rendimiento\"], reverse=True)\n","\n","# Imprimir ranking\n","print(\"=== RANKING DE ACCIONES ===\\n\")\n","for i, r in enumerate(resultados):\n","    emoji = \"📈\" if r[\"rendimiento\"] > 0 else \"📉\"\n","    print(f\"{i+1}. {r['ticker']} {emoji}\")\n","    print(f\"   Rendimiento:  {r['rendimiento']:.2f}%\")\n","    print(f\"   $10,000 →    ${10000 + r['ganancia']:,.2f}\")\n","    print(f\"   Volatilidad: {r['volatilidad']:.2f}%\")\n","    print(f\"   Señal:       {r['señal']}\")\n","    print()\n","\n","# Gráficas automáticas\n","fig, axes = plt.subplots(len(resultados), 1, figsize=(14, 4*len(resultados)))\n","fig.suptitle(\"Análisis de Acciones — 6 meses\", fontsize=16, fontweight=\"bold\")\n","\n","for i, r in enumerate(resultados):\n","    datos = r[\"datos\"]\n","    ma20 = datos[\"Close\"].rolling(20).mean()\n","    ma50 = datos[\"Close\"].rolling(50).mean()\n","\n","    axes[i].plot(datos[\"Close\"], color=\"green\", linewidth=1, alpha=0.6, label=\"Precio\")\n","    axes[i].plot(ma20, color=\"blue\", linewidth=2, label=\"MA20\")\n","    axes[i].plot(ma50, color=\"red\", linewidth=2, label=\"MA50\")\n","    axes[i].set_title(f\"{r['ticker']} — {r['rendimiento']:.2f}% | {r['señal']}\")\n","    axes[i].legend()\n","    axes[i].grid(True)\n","\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"jcDwMe-FGNei","executionInfo":{"status":"ok","timestamp":1778432552669,"user_tz":360,"elapsed":2275,"user":{"displayName":"Rey Velazquez","userId":"13727220374920306428"}},"outputId":"20d31da8-2c10-41d8-e858-45f257c435db"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["=== RANKING DE ACCIONES ===\n","\n","1. RXT 📈\n","   Rendimiento:  355.60%\n","   $10,000 →    $45,560.16\n","   Volatilidad: 23.98%\n","   Señal:       ✅ COMPRA\n","\n","2. INOD 📈\n","   Rendimiento:  23.85%\n","   $10,000 →    $12,385.47\n","   Volatilidad: 9.21%\n","   Señal:       ✅ COMPRA\n","\n","3. FROG 📈\n","   Rendimiento:  9.69%\n","   $10,000 →    $10,968.60\n","   Volatilidad: 4.88%\n","   Señal:       ✅ COMPRA\n","\n","4. AAPL 📈\n","   Rendimiento:  8.97%\n","   $10,000 →    $10,896.87\n","   Volatilidad: 1.42%\n","   Señal:       ✅ COMPRA\n","\n","5. SLNH 📉\n","   Rendimiento:  -28.52%\n","   $10,000 →    $7,148.44\n","   Volatilidad: 10.09%\n","   Señal:       ✅ COMPRA\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x2000 with 5 Axes>"],"image/png":"\n"},"metadata":{}}]}]}
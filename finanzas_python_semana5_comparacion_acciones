mejorada: Ranking ordenado y limpio\n","\n","import yfinance as yf\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","tickers = [\"INTC\", \"MU\", \"RKLB\", \"NVDA\", \"AAPL\"]\n","resultados = []\n","\n","for ticker in tickers:\n","    datos = yf.download(ticker, period=\"1y\", progress=False)\n","    inicio = float(datos[\"Close\"].iloc[0])\n","    fin = float(datos[\"Close\"].iloc[-1])\n","    rend = ((fin - inicio) / inicio) * 100\n","    resultados.append({\"Acción\": ticker, \"Inicio\": inicio, \"Fin\": fin, \"Rendimiento %\": rend})\n","\n","import pandas as pd\n","df = pd.DataFrame(resultados)\n","df = df.sort_values(\"Rendimiento %\", ascending=False).reset_index(drop=True)\n","df[\"Inicio\"] = df[\"Inicio\"].map(\"${:.2f}\".format)\n","df[\"Fin\"] = df[\"Fin\"].map(\"${:.2f}\".format)\n","df[\"Rendimiento %\"] = df[\"Rendimiento %\"].map(\"{:.2f}%\".format)\n","print(df.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Fe_MuXbA12qc","executionInfo":{"status":"ok","timestamp":1778399026855,"user_tz":360,"elapsed":710,"user":{"displayName":"Rey Velazquez","userId":"13727220374920306428"}},"outputId":"fe6c8813-89fb-443f-f8ed-c9515d640690"},"execution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["Acción  Inicio     Fin Rendimiento %\n","    MU  $85.65 $746.81       771.88%\n","  INTC  $21.42 $124.92       483.19%\n","  RKLB  $20.51 $105.47       414.24%\n","  NVDA $116.62 $215.20        84.53%\n","  AAPL $197.67 $293.32        48.39%\n"]}]}]}
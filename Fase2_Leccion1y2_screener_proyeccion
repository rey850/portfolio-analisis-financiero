{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyM88224w2YySAK0q+wA/shB"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["# Fase 2 - Lección 1: Screener automático de acciones\n","\n","import yfinance as yf\n","import pandas as pd\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","tickers = [\n","    \"AAPL\", \"MSFT\", \"GOOGL\", \"NVDA\", \"AMD\", \"INTC\", \"META\",\n","    \"RKLB\", \"LMT\", \"RTX\", \"NOC\",\n","    \"TSLA\", \"AMZN\", \"WMT\", \"NKE\",\n","    \"JPM\", \"BAC\", \"GS\", \"XOM\", \"CVX\"\n","]\n","\n","periodo = \"3mo\"\n","resultados = []\n","\n","print(\"Analizando acciones... ⏳\")\n","\n","for ticker in tickers:\n","    try:\n","        datos = yf.download(ticker, period=periodo, progress=False)\n","        if datos.empty or len(datos) < 50:\n","            continue\n","\n","        precio_actual = float(datos[\"Close\"].iloc[-1])\n","        precio_inicio = float(datos[\"Close\"].iloc[0])\n","        rendimiento = ((precio_actual - precio_inicio) / precio_inicio) * 100\n","        volatilidad = float(datos[\"Close\"].pct_change().std() * 100)\n","        ma20 = float(datos[\"Close\"].rolling(20).mean().iloc[-1])\n","        ma50 = float(datos[\"Close\"].rolling(50).mean().iloc[-1])\n","        señal = \"COMPRA\" if ma20 > ma50 else \"VENTA\"\n","        ganancia = (rendimiento / 100) * 100\n","\n","        resultados.append({\n","            \"Ticker\": ticker,\n","            \"Precio\": round(precio_actual, 2),\n","            \"Rendimiento\": round(rendimiento, 2),\n","            \"10k_resultado\": round(100 + ganancia, 2),\n","            \"Volatilidad\": round(volatilidad, 2),\n","            \"Señal\": señal\n","        })\n","        print(f\"✅ {ticker} analizado\")\n","    except Exception as e:\n","        print(f\"❌ {ticker} error: {e}\")\n","\n","df = pd.DataFrame(resultados)\n","df = df.sort_values(\"Rendimiento\", ascending=False).reset_index(drop=True)\n","mejores = df[(df[\"Señal\"] == \"COMPRA\") & (df[\"Rendimiento\"] > 0)]\n","\n","print(\"\\n=== TOP OPORTUNIDADES ===\\n\")\n","print(mejores.to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pJdU1HPU7wVN","executionInfo":{"status":"ok","timestamp":1778434507200,"user_tz":360,"elapsed":3172,"user":{"displayName":"Rey Velazquez","userId":"13727220374920306428"}},"outputId":"2e03fe2b-84b1-4cdc-ec27-0649bc8ef7f4"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["Analizando acciones... ⏳\n","✅ AAPL analizado\n","✅ MSFT analizado\n","✅ GOOGL analizado\n","✅ NVDA analizado\n","✅ AMD analizado\n","✅ INTC analizado\n","✅ META analizado\n","✅ RKLB analizado\n","✅ LMT analizado\n","✅ RTX analizado\n","✅ NOC analizado\n","✅ TSLA analizado\n","✅ AMZN analizado\n","✅ WMT analizado\n","✅ NKE analizado\n","✅ JPM analizado\n","✅ BAC analizado\n","✅ GS analizado\n","✅ XOM analizado\n","✅ CVX analizado\n","\n","=== TOP OPORTUNIDADES ===\n","\n","Ticker  Precio  Rendimiento  10k_resultado  Volatilidad  Señal\n","  INTC  124.92       148.65         248.65         5.49 COMPRA\n","   AMD  455.19       110.74         210.74         4.57 COMPRA\n","  RKLB  105.47        39.07         139.07         6.76 COMPRA\n","  AMZN  272.68        30.64         130.64         1.82 COMPRA\n"," GOOGL  400.80        23.67         123.67         2.16 COMPRA\n","  NVDA  215.20        13.25         113.25         2.28 COMPRA\n","  AAPL  293.32         6.81         106.81         1.63 COMPRA\n","  TSLA  428.35         2.64         102.64         2.41 COMPRA\n","   WMT  130.43         1.49         101.49         1.59 COMPRA\n","  MSFT  415.12         0.60         100.60         1.71 COMPRA\n"]}]},{"cell_type":"code","source":["# ================================================\n","# PROYECCIÓN + IMPUESTOS — Fácil de modificar\n","# ================================================\n","\n","import yfinance as yf\n","import matplotlib.pyplot as plt\n","import pandas as pd\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","# ================================\n","# MODIFICA SOLO ESTA SECCIÓN ↓\n","ticker = \"AMD\"           # Acción\n","periodo_historico = \"3mo\" # 1mo, 3mo, 6mo, 1y, 2y\n","meses_a_proyectar = 3     # Meses hacia adelante\n","capital = 1000           # Dinero a invertir\n","# ================================\n","\n","# Descargar datos\n","datos = yf.download(ticker, period=periodo_historico, progress=False)\n","precio_actual = float(datos[\"Close\"].iloc[-1])\n","precio_inicio = float(datos[\"Close\"].iloc[0])\n","rendimiento_historico = ((precio_actual - precio_inicio) / precio_inicio) * 100\n","dias = len(datos)\n","meses_historicos = dias / 21\n","rendimiento_mensual = rendimiento_historico / meses_historicos\n","\n","# 3 escenarios\n","escenario_optimista = rendimiento_mensual * 1.5\n","escenario_moderado  = rendimiento_mensual\n","escenario_pesimista = rendimiento_mensual * 0.5\n","\n","# Tabla de proyecciones\n","filas = []\n","for mes in range(1, meses_a_proyectar + 1):\n","    precio_opt = precio_actual * (1 + escenario_optimista / 100) ** mes\n","    precio_mod = precio_actual * (1 + escenario_moderado  / 100) ** mes\n","    precio_pes = precio_actual * (1 + escenario_pesimista / 100) ** mes\n","    filas.append({\n","        \"Mes\": mes,\n","        \"🟢 Optimista\": f\"${capital * (precio_opt / precio_actual):,.0f}\",\n","        \"🟡 Moderado\":  f\"${capital * (precio_mod / precio_actual):,.0f}\",\n","        \"🔴 Pesimista\":  f\"${capital * (precio_pes / precio_actual):,.0f}\",\n","    })\n","\n","df = pd.DataFrame(filas)\n","\n","# Reporte\n","print(f\"{'='*50}\")\n","print(f\"  PROYECCIÓN — {ticker}\")\n","print(f\"{'='*50}\")\n","print(f\"  Precio actual:       ${precio_actual:.2f}\")\n","print(f\"  Historial usado:     {periodo_historico}\")\n","print(f\"  Capital invertido:   ${capital:,}\")\n","print(f\"  Rendimiento mensual: {rendimiento_mensual:.2f}%\")\n","print(f\"{'='*50}\\n\")\n","print(df.to_string(index=False))\n","print(f\"\\n⚠️  Proyección estimada — no es garantía de ganancia\")\n","\n","# Gráfica\n","meses = list(range(1, meses_a_proyectar + 1))\n","opt = [capital * (1 + escenario_optimista / 100) ** m for m in meses]\n","mod = [capital * (1 + escenario_moderado  / 100) ** m for m in meses]\n","pes = [capital * (1 + escenario_pesimista / 100) ** m for m in meses]\n","\n","plt.figure(figsize=(10, 5))\n","plt.plot(meses, opt, color=\"green\",  linewidth=2, marker=\"o\", label=\"🟢 Optimista\")\n","plt.plot(meses, mod, color=\"orange\", linewidth=2, marker=\"o\", label=\"🟡 Moderado\")\n","plt.plot(meses, pes, color=\"red\",    linewidth=2, marker=\"o\", label=\"🔴 Pesimista\")\n","plt.axhline(y=capital, color=\"gray\", linestyle=\"--\", label=\"Capital inicial\")\n","plt.title(f\"Proyección de ${capital:,} en {ticker} — {meses_a_proyectar} meses\")\n","plt.xlabel(\"Meses\")\n","plt.ylabel(\"Valor estimado ($)\")\n","plt.legend()\n","plt.grid(True)\n","plt.tight_layout()\n","plt.show()\n","\n","# Calculadora de impuestos\n","print(f\"\\n{'='*50}\")\n","print(f\"  CALCULADORA DE IMPUESTOS — {ticker}\")\n","print(f\"{'='*50}\")\n","\n","escenarios = {\n","    \"🟢 Optimista\": opt[-1],\n","    \"🟡 Moderado\":  mod[-1],\n","    \"🔴 Pesimista\":  pes[-1]\n","}\n","\n","for nombre, valor_final in escenarios.items():\n","    ganancia_bruta = valor_final - capital\n","    if ganancia_bruta > 0:\n","        impuesto = ganancia_bruta * 0.10\n","        ganancia_neta = ganancia_bruta - impuesto\n","        valor_neto = capital + ganancia_neta\n","        print(f\"\\n  {nombre}\")\n","        print(f\"  Valor final bruto:  ${valor_final:,.2f}\")\n","        print(f\"  Ganancia bruta:     ${ganancia_bruta:,.2f}\")\n","        print(f\"  ISR (10%):         -${impuesto:,.2f}\")\n","        print(f\"  Ganancia neta:      ${ganancia_neta:,.2f}\")\n","        print(f\"  Valor neto final:   ${valor_neto:,.2f}\")\n","    else:\n","        print(f\"\\n  {nombre}\")\n","        print(f\"  Pérdida: ${ganancia_bruta:,.2f} — no pagas impuestos\")\n","\n","print(f\"\\n{'='*50}\")\n","print(f\"⚠️  ISR México 10% sobre ganancias de capital\")\n","print(f\"    Consulta a un contador para tu caso específico\")\n","print(f\"{'='*50}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"XoNaPNAOBA2y","executionInfo":{"status":"ok","timestamp":1778436352045,"user_tz":360,"elapsed":555,"user":{"displayName":"Rey Velazquez","userId":"13727220374920306428"}},"outputId":"0d6c9468-506f-4477-a02f-226b33888c3d"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["==================================================\n","  PROYECCIÓN — AMD\n","==================================================\n","  Precio actual:       $455.19\n","  Historial usado:     3mo\n","  Capital invertido:   $1,000\n","  Rendimiento mensual: 36.91%\n","==================================================\n","\n"," Mes 🟢 Optimista 🟡 Moderado 🔴 Pesimista\n","   1      $1,554     $1,369      $1,185\n","   2      $2,414     $1,874      $1,403\n","   3      $3,750     $2,566      $1,662\n","\n","⚠️  Proyección estimada — no es garantía de ganancia\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","==================================================\n","  CALCULADORA DE IMPUESTOS — AMD\n","==================================================\n","\n","  🟢 Optimista\n","  Valor final bruto:  $3,750.47\n","  Ganancia bruta:     $2,750.47\n","  ISR (10%):         -$275.05\n","  Ganancia neta:      $2,475.42\n","  Valor neto final:   $3,475.42\n","\n","  🟡 Moderado\n","  Valor final bruto:  $2,566.40\n","  Ganancia bruta:     $1,566.40\n","  ISR (10%):         -$156.64\n","  Ganancia ne
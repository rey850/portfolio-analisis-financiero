al_accion * (1 + rendimiento_mensual * 1.5 / 100) ** meses\n","    val_mod = capital_accion * (1 + rendimiento_mensual       / 100) ** meses\n","    val_pes = capital_accion * (1 + rendimiento_mensual * 0.5 / 100) ** meses\n","\n","    tipo = \"Agresiva\" if porcentaje >= 0.40 else \"Moderada\" if porcentaje >= 0.30 else \"Conservadora\"\n","\n","    print(f\"  {ticker} ({tipo}) — {int(porcentaje*100)}% = ${capital_accion:,.0f}\")\n","    print(f\"  Rendimiento histórico: {rendimiento_historico:.2f}%\")\n","    print(f\"  🟢 Optimista:  ${val_opt:,.2f}\")\n","    print(f\"  🟡 Moderado:   ${val_mod:,.2f}\")\n","    print(f\"  🔴 Pesimista:  ${val_pes:,.2f}\")\n","    print()\n","\n","    resultados.append({\n","        \"ticker\": ticker,\n","        \"tipo\": tipo,\n","        \"porcentaje\": porcentaje,\n","        \"capital\": capital_accion,\n","        \"opt\": val_opt,\n","        \"mod\": val_mod,\n","        \"pes\": val_pes\n","    })\n","\n","# Totales\n","total_opt = sum(r[\"opt\"] for r in resultados)\n","total_mod = sum(r[\"mod\"] for r in resultados)\n","total_pes = sum(r[\"pes\"] for r in resultados)\n","\n","# Impuestos\n","imp_opt = max(0, (total_opt - capital_total) * 0.10)\n","imp_mod = max(0, (total_mod - capital_total) * 0.10)\n","imp_pes = max(0, (total_pes - capital_total) * 0.10)\n","\n","neto_opt = total_opt - imp_opt\n","neto_mod = total_mod - imp_mod\n","neto_pes = total_pes - imp_pes\n","\n","print(f\"{'='*60}\")\n","print(f\"  RESUMEN PARA {nombre_cliente.upper()}\")\n","print(f\"{'='*60}\")\n","print(f\"  Capital inicial:         ${capital_total:,.2f}\")\n","print(f\"  🟢 Mejor escenario:      ${neto_opt:,.2f}  (ganas ${neto_opt-capital_total:,.2f})\")\n","print(f\"  🟡 Escenario normal:     ${neto_mod:,.2f}  (ganas ${neto_mod-capital_total:,.2f})\")\n","print(f\"  🔴 Peor escenario:       ${neto_pes:,.2f}  (ganas ${neto_pes-capital_total:,.2f})\")\n","print(f\"\\n  Impuestos ISR 10%:\")\n","print(f\"  🟢 Optimista:  ${imp_opt:,.2f}\")\n","pri